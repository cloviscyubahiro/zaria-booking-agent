# Copy this file to .env  (cp .env.example .env)  and fill in what you need.
# .env holds secrets: it is never committed to git and never pasted in chat.

# ---- WhatsApp (Settings sheet: Channel = WhatsApp) ----
# Meta for Developers > your app > WhatsApp > API Setup. Use a permanent
# System User token (README, WhatsApp setup step 7) - test tokens expire in 24 h.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The approved template (README, WhatsApp setup step 4).
WHATSAPP_TEMPLATE_NAME=zaria_court_update
WHATSAPP_TEMPLATE_LANG=en
# Meta Graph API version. v25.0 is supported until July 2028.
WHATSAPP_API_VERSION=v25.0

# ---- SMS through Pindo (Settings sheet: Channel = SMS) ----
# Pindo dashboard > Profile > Security.
PINDO_TOKEN=

# ---- Optional ----
# Ticqet's public Firebase web key. Leave empty: the agent reads it from ticqet.rw.
FIREBASE_API_KEY=
